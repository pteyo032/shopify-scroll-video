{% liquid
  assign block_settings = block.settings
  assign modifier = ''
  if block_settings.grow_direction == 'left'
    assign modifier = ' video-scroll-tooltip--grows-left'
  endif
%}

<div
  class="video-scroll-tooltip{{ modifier }}"
  ref="tooltip[]"
  data-start-time="{{ block_settings.start_time }}"
  data-end-time="{{ block_settings.end_time }}"
  style="
    left: {{ block_settings.position_x }}%;
    top: {{ block_settings.position_y }}%;
    --tooltip-thickness: {{ block_settings.line_thickness }}px;
  "
  {{ block.shopify_attributes }}
>
  <span class="video-scroll-tooltip__circle"></span>
  <span class="video-scroll-tooltip__line" style="width: {{ block_settings.line_length }}px;"></span>
  <span class="video-scroll-tooltip__content">
    {% if block_settings.headline != blank %}
      <span
        class="video-scroll-tooltip__headline"
        {% if block_settings.headline_font_size != blank %}
          style="font-size: {{ block_settings.headline_font_size }};"
        {% endif %}
      >{{ block_settings.headline }}</span>
    {% endif %}
    {% if block_settings.description != blank %}
      <span
        class="video-scroll-tooltip__description"
        {% if block_settings.description_font_size != blank %}
          style="font-size: {{ block_settings.description_font_size }};"
        {% endif %}
      >{{ block_settings.description }}</span>
    {% endif %}
  </span>
</div>

{% schema %}
{
  "name": "t:names.video_scroll_tooltip",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.position"
    },
    {
      "type": "range",
      "id": "position_x",
      "label": "t:settings.position_x",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "position_y",
      "label": "t:settings.position_y",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "grow_direction",
      "label": "t:settings.grow_direction",
      "options": [
        {
          "value": "right",
          "label": "t:options.right"
        },
        {
          "value": "left",
          "label": "t:options.left"
        }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "line_length",
      "label": "t:settings.line_length",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "t:settings.line_thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "t:content.timing"
    },
    {
      "type": "range",
      "id": "start_time",
      "label": "t:settings.start_time",
      "info": "t:info.tooltip_timing",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "unit": "s",
      "default": 1
    },
    {
      "type": "range",
      "id": "end_time",
      "label": "t:settings.end_time",
      "min": 0,
      "max": 10,
      "step": 0.1,
      "unit": "s",
      "default": 2
    },
    {
      "type": "header",
      "content": "t:content.text"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "t:settings.headline"
    },
    {
      "type": "select",
      "id": "headline_font_size",
      "label": "t:settings.size",
      "options": [
        { "value": "", "label": "t:options.default" },
        { "value": "0.75rem", "label": "12px" },
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" },
        { "value": "1.25rem", "label": "20px" },
        { "value": "1.5rem", "label": "24px" }
      ],
      "default": ""
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "select",
      "id": "description_font_size",
      "label": "t:settings.size",
      "options": [
        { "value": "", "label": "t:options.default" },
        { "value": "0.75rem", "label": "12px" },
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" },
        { "value": "1.25rem", "label": "20px" },
        { "value": "1.5rem", "label": "24px" }
      ],
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "t:names.video_scroll_tooltip"
    }
  ]
}
{% endschema %}
